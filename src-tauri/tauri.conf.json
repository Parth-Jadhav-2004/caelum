{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caelum",
  "version": "0.4.2",
  "identifier": "io.caelum.Dictation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caelum",
        "backgroundColor": "#121214",
        "width": 1100,
        "height": 780,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../public/licenses/": "licenses/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "targets": ["deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png"],
    "externalBin": ["binaries/caelum-engine"]
  }
}
