{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caelum",
  "version": "0.4.0",
  "identifier": "io.caelum.Dictation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caelum",
        "width": 1100,
        "height": 780,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "externalBin": [
      "binaries/caelum-engine"
    ]
  }
}
