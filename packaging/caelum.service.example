# Copy to ~/.config/systemd/user/caelum.service and replace /ABSOLUTE/PATH.
# Import Wayland/Hyprland environment before starting this user service.
[Unit]
Description=Caelum push-to-talk dictation
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/ABSOLUTE/PATH/caelum
ExecStart=/ABSOLUTE/PATH/caelum/.venv/bin/caelum serve
EnvironmentFile=-%h/.config/caelum/environment
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=graphical-session.target
