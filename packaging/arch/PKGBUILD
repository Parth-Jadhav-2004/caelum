# Build from the checked-out release tree; dependency payload is locked in uv.lock.
pkgname=caelum
pkgver=0.4.0
pkgrel=1
pkgdesc='Linux dictation with Tauri and local transcript history'
arch=('x86_64')
url='https://github.com/Parth-Jadhav-2004/caelum'
license=('custom')
depends=('python>=3.14' 'python<3.15' 'webkit2gtk-4.1' 'libappindicator-gtk3' 'portaudio' 'libpulse' 'libnotify' 'libsecret' 'wl-clipboard' 'xclip' 'glib2' 'systemd' 'openssl' 'polkit' 'python-gobject' 'python-cairo' 'gtk4')
makedepends=('git' 'rust' 'nodejs' 'npm' 'uv' 'zstd')
optdepends=('gtk4-layer-shell: native Hyprland recording overlay')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')
build() {
  cd "$srcdir/$pkgname"
  python scripts/build_package.py arch
}
package() {
  cd "$srcdir/$pkgname"
  bsdtar --exclude=.PKGINFO -xf "dist/caelum-$pkgver-1-x86_64.pkg.tar.zst" -C "$pkgdir"
}
